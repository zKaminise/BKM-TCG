# Modelo público; copie manualmente para .env.sandbox na raiz do projeto.
# Nunca copie a .env principal. As credenciais abaixo ficam vazias de propósito.
# O CLI de homologação lê SOMENTE .env.sandbox, sem herdar process.env.
BKM_ENVIRONMENT=staging
BKM_PUBLIC_URL=https://bkm-tcg-sandbox.vercel.app
HOSTING_DEMO_ONLY=false
EMAIL_PROVIDER=development
RESEND_ENABLED=false
GOOGLE_AUTH_ENABLED=false

# Novo projeto de banco dedicado à homologação; nunca o projeto principal.
SUPABASE_URL=
DATABASE_URL=
BKM_DB_POOL_SIZE=1
DATABASE_SSL_VERIFY=true

# Somente credenciais da seção Testes do vendedor de teste confirmado via GET.
PAYMENT_PROVIDER=mercadopago
MERCADO_PAGO_ENABLED=true
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_PRODUCTION_APPROVED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SELLER_ID=3466948980

# Conta compradora de teste do painel MP, diferente da conta vendedora.
# Não inclua documento, senha do provedor, cartão, PAN ou CVV neste arquivo.
BKM_SANDBOX_BUYER_EMAIL=

# Substitua <ref> pela referência de 20 letras do NOVO projeto dedicado.
# A execução --run requer correspondência literal; --verify não usa a frase.
BKM_SANDBOX_CONFIRMATION=SANDBOX_ONLY:<ref>:3466948980
