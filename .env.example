# Copie para .env SOMENTE no computador/servidor. Nunca envie .env ao GitHub.
# Node 22.13+; npm start, migrations, seed e bootstrap carregam .env automaticamente.
PORT=4173
BKM_PUBLIC_URL=http://localhost:4173
BKM_ENVIRONMENT=demo
HOSTING_DEMO_ONLY=true
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=development

# Banco dedicado da demonstração local. Não é usado quando DATABASE_URL existe.
BKM_DB_PATH=data/demo.sqlite
# Supabase: URI do pooler em modo transaction, porta 6543; somente no servidor.
DATABASE_URL=
BKM_DB_POOL_SIZE=1
DATABASE_SSL_VERIFY=true
# Certificado CA do projeto, se necessário; use \\n para quebras dentro do valor.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bkm-public

# Mercado Pago permanece DESLIGADO na demonstração, mesmo se houver chaves.
# Sandbox exige projeto separado, BKM_ENVIRONMENT=staging, HOSTING_DEMO_ONLY=false,
# PAYMENT_PROVIDER=mercadopago, contas de teste e credenciais corretas do provedor.
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_PRODUCTION_APPROVED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SELLER_ID=

# Resend: somente após domínio/remetente verificados. Demo sempre gera prévias.
RESEND_ENABLED=false
RESEND_DOMAIN_VERIFIED=false
RESEND_API_KEY=
RESEND_FROM=

# Google OIDC: somente após credenciais e callback exato no Google Cloud.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Por padrão: BKM_PUBLIC_URL + /api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Resend controlado em demo não habilita pagamentos nem campanhas.
# Exige domínio/remetente verificados e destinatários exatos autorizados.
RESEND_DEMO_TEST_ENABLED=false
RESEND_TEST_RECIPIENTS=
RESEND_WEBHOOK_SECRET=
# Lembretes de carrinho permanecem sem automação nesta fase.
ABANDONED_CART_ENABLED=false

# Backup AES-256-GCM: gere 32 bytes pelo CLI create-key, sem imprimir a chave.
# Guarde cópia privada separada: sem ela o backup não pode ser restaurado.
BKM_BACKUP_KEY=
## Vercel Node: preserve o stream original para validar webhooks assinados.
NODEJS_HELPERS=0

# Consumidor diário independente: 12 UTC (09h Brasília; precisão de uma hora no Hobby).
# Gere 32 bytes aleatórios em base64url; deixe vazio até configurar o Secret privado.
# Vercel: Bearer no cron diário. Supabase Cron: mesma chave pelo Vault e HMAC-SHA256
# GET /api/jobs/commerce com timestamp em segundos e janela de 90s. A fila pg_net
# recebe somente MAC/timestamp, nunca a chave. Veja docs/CRON-COMERCIO.md.
# Sem a chave os endpoints /api/jobs/email e /api/jobs/commerce respondem 401.
CRON_SECRET=

# Frete: desligado até configurar origem, peso/medidas/capacidade e credencial autorizada.
# Cotação/rastreio apenas; a integração não compra etiquetas.
SHIPPING_PROVIDER=disabled
MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ORIGIN_ZIP=
MELHOR_ENVIO_USER_AGENT=
MELHOR_ENVIO_SERVICES=
